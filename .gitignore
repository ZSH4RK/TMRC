__pycache__/
*.pyc

# Trained SAC checkpoints + best-run recordings (bind-mounted from the host
# in docker-compose.yml so they survive container rebuilds) — binary/large,
# not source.
agent/tmp/*
!agent/tmp/.gitkeep

# Local notes
Plan.md

# Recorded runs (see agent/experiments/) — bind-mounted from the host in
# docker-compose.yml. Large and machine-specific; keep or share them on purpose.
results/*
!results/.gitkeep

# Debug output
*.log
